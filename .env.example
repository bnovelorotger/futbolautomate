APP_ENV=local
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/futbol_balear
LOG_LEVEL=INFO
LOG_JSON=false
TIMEZONE=Europe/Madrid
REQUEST_TIMEOUT_SECONDS=20
REQUEST_RETRIES=3
REQUEST_BACKOFF_SECONDS=0.75
USER_AGENT=FutbolBalearBot/0.1 (+https://example.com; contacto@example.com)
RESPECT_ROBOTS_TXT=true
DEBUG_RESPONSE_DIR=.debug_responses
DRY_RUN=false
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8000/callback
X_SCOPES=tweet.read tweet.write users.read offline.access
X_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com
X_AUTHORIZE_URL=https://x.com/i/oauth2/authorize
X_TOKEN_URL=https://api.x.com/2/oauth2/token
ENABLE_TEAM_MENTIONS=true
MAX_MENTIONS_PER_POST=3
LEGACY_EXPORT_JSON_ENABLED=false
TYPEFULLY_API_KEY=

# Editorial rewrite (opcional, requerido para smoke test real)
EDITORIAL_REWRITE_PROVIDER=groq
EDITORIAL_REWRITE_API_KEY=
EDITORIAL_REWRITE_API_URL=https://api.groq.com/openai/v1/chat/completions
EDITORIAL_REWRITE_MODEL=openai/gpt-oss-20b
EDITORIAL_REWRITE_MAX_CHARS=280

# Fase 3 rollout local/staging
EDITORIAL_REWRITE_HUMANIZED_LOCAL_ENABLED=false
EDITORIAL_PHASE3_ROLLOUT_ENABLED=false

# Telegram notifications (opcional)
# TELEGRAM_BOT_TOKEN=<token-del-bot>
# TELEGRAM_CHAT_ID=<chat-id-del-usuario>

# Browser publisher de X
X_BROWSER_STATE_FILE=.x_browser_state.json
X_BROWSER_HEADLESS=false
X_BROWSER_TYPING_DELAY_MS=30
X_BROWSER_STAGGER_SECONDS=1800
X_BROWSER_RELEASE_ACTION_LIMIT=4
